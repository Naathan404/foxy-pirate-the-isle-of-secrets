; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="foxy-pirate-the-isle-of-secret"
run/main_scene="res://world/hub/scenes/hub.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

HitstopController="*res://core/autoload/hitstop_controller.gd"
ScreenShakeController="*res://core/autoload/screen_shake_controller.gd"
GameManager="*res://core/autoload/game_manager.gd"
Dialogic="*uid://ds2q0uclmolvu"
AudioManager="*res://core/autoload/audio_manager.gd"
SilasProgress="*res://gameplay/merchant/silas_progress_store.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dialogic]

directories/dch_directory={
"master_tortuga": "res://dialog/npcs/master_tortuga/master_tortuga.dch",
"mushroom": "res://dialog/npcs/mushroom/mushroom.dch",
"silas": "res://dialog/npcs/silas/silas.dch"
}
directories/dtl_directory={
"farewell": "res://dialog/npcs/silas/timelines/farewell.dtl",
"first_meeting": "res://dialog/npcs/silas/timelines/first_meeting.dtl",
"greeting": "res://dialog/npcs/mushroom/timelines/greeting.dtl",
"master_tortuga/farewell": "res://dialog/npcs/master_tortuga/farewell.dtl",
"master_tortuga/greeting": "res://dialog/npcs/master_tortuga/greeting.dtl",
"timelines/greeting": "res://dialog/npcs/silas/timelines/greeting.dtl"
}
layout/style_directory={}
layout/style_list=[]
layout/default_style="Default"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
variables={}
glossary/default_case_sensitive=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="foxy-pirate-the-isle-of-secret"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_ai/plugin.cfg")
<<<<<<<HEADenabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

