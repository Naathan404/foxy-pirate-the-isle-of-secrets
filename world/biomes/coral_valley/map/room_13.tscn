[node name="room_13" unique_id=2133176597 instance=ExtResource("1_base")]
editor_description = "Violet Shrine: the south beach joins room_05 and room_14 on foot. North-west, a chain of islets over the violet sea leads to the altar of the Pearl of the Deep: three Tide Grapple hops (more SP than Foxy holds, so he must wait on an islet under skeleton fire). From the altar islet a single hop east brings him back; that hop only works one way."
open_exits = 6
right_destination_scene = "res://world/biomes/coral_valley/map/room_14.tscn"
down_destination_scene = "res://world/biomes/coral_valley/map/room_05.tscn"

