[node name="room_23" unique_id=1607608505 instance=ExtResource("1_base")]
editor_description = "Timing Quiz with the Pearl of Wit: the outer platform loops clockwise around the fixed centre; the lever on the centre stops it at the next marker or sets it going. North of the N stop floats the pearl platform: reach it by stopping the loop at N (or NW/NE) and dashing over. Its own lever stops/starts the loop for the way back. The east pier stands on a rock cut off by a grapple gap: the way to the hidden room_24."
