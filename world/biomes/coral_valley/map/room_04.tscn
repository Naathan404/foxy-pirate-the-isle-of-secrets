[node name="room_04" unique_id=1963513335 instance=ExtResource("1_base")]
editor_description = "Quiz 04: fixed center platform; the orbit platform runs a ring of 8 stops (E, SE, S, SW, W, NW, N, NE) around it and carries Foxy. Only the W and E stops touch an island and the center, a dash apart. Upper levers move it +3 stops clockwise, lower levers -2 (counterclockwise); the island pairs and the pair on the center platform all drive the same platform, so Foxy can cross island -> W -> center -> E -> island with any weapon."
boundary_openings = Array[Rect2]([Rect2(12.7, -3.3355203, 2, 5.78), Rect2(40.286148, -3.3355203, 2, 5.78)])
up_destination_scene = "res://world/biomes/coral_valley/map/room_11.tscn"
right_destination_scene = "res://world/biomes/coral_valley/map/room_05.tscn"
down_destination_scene = "res://world/biomes/coral_valley/map/room_19.tscn"
left_destination_scene = "res://world/biomes/coral_valley/map/room_03.tscn"

