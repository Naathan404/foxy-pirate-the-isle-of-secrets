[node name="room_03" unique_id=455104233 instance=ExtResource("1_base")]
editor_description = "Bridge Dock (lever tutorial): an 8 m channel parts the beach from the east dock. Two platforms must slide into the bridge line: the west lever calls platform A, the lever riding on A calls platform B (and B calls A on the way back); the east lever calls B. Falling in the channel is a fall into the sea."
